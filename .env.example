# CognoDB Cloud (console.cognodb.com) — free c0 instance
COGNODB_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=

# Neo4j AuraDB Free (console.neo4j.io)
AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
AURA_USER=neo4j
AURA_PASSWORD=

# Self-hosted via docker-compose.yml — defaults match the compose file, override only if changed
NEO4J_COMMUNITY_URI=bolt://localhost:7687
NEO4J_COMMUNITY_USER=neo4j
NEO4J_COMMUNITY_PASSWORD=

MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

ARANGODB_URI=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=
